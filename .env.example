NEXT_PUBLIC_FIREBASE_API_KEY=your-public-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Optional: location search and maps work after this is configured.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Local Admin SDK: use the absolute path to your untracked service account file,
# or Application Default Credentials configured outside this repository.
# GOOGLE_APPLICATION_CREDENTIALS=
# Firebase App Hosting uses its assigned service account automatically.
